FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash bubblewrap ca-certificates git ripgrep socat sqlite3 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir claude-agent-sdk==0.2.152
RUN useradd --create-home --uid 1000 benchmark
COPY claude_api.py /opt/benchmark/claude_api.py
USER benchmark
ENTRYPOINT ["python", "/opt/benchmark/claude_api.py"]
