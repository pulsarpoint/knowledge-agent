FROM node:22-alpine AS build
# corepack ships with node and provisions the pnpm version pinned by
# package.json's "packageManager" field
RUN corepack enable
WORKDIR /workspace/services/docs-wiki-ui
COPY services/docs-wiki-ui/package.json services/docs-wiki-ui/pnpm-lock.yaml ./
COPY packages/chat-ui /workspace/packages/chat-ui
RUN pnpm install --frozen-lockfile
COPY services/docs-wiki-ui/ ./
RUN pnpm run build

FROM nginx:1.27-alpine
COPY --from=build /workspace/services/docs-wiki-ui/build/client /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
