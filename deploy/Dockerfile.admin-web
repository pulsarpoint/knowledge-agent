FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /workspace/services/admin-ui
COPY services/admin-ui/package.json services/admin-ui/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY services/admin-ui/ ./
RUN pnpm run build

FROM nginx:1.27-alpine
COPY --from=build /workspace/services/admin-ui/build/client /usr/share/nginx/html
COPY deploy/nginx-admin.conf /etc/nginx/conf.d/default.conf
