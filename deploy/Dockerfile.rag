FROM python:3.12-slim
RUN pip install --no-cache-dir uv
WORKDIR /services/rag
COPY packages/llm-settings /packages/llm-settings
COPY services/rag/pyproject.toml services/rag/uv.lock ./
COPY services/rag/src ./src
COPY services/rag/README.md ./
RUN uv sync --frozen --no-dev
EXPOSE 8790
ENTRYPOINT ["uv", "run", "rag"]
CMD ["serve-workspace", "--host", "0.0.0.0"]
