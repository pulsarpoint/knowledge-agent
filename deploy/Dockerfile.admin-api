FROM node:22-bookworm-slim AS codegraph
WORKDIR /services/code-graph
COPY services/code-graph/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
RUN node node_modules/@ast-grep/cli/postinstall.js
COPY services/code-graph/index.cjs ./
COPY services/code-graph/query.cjs ./

FROM python:3.12-slim
COPY --from=codegraph /usr/local/bin/node /usr/local/bin/node
COPY --from=codegraph /services/code-graph /services/code-graph
COPY --from=codegraph /services/code-graph/node_modules/@ast-grep/cli/ast-grep /usr/local/bin/ast-grep
RUN ast-grep --version
RUN apt-get update && apt-get install -y --no-install-recommends bash bubblewrap git openssh-client ripgrep ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
WORKDIR /services/admin-api
COPY packages/llm-settings /packages/llm-settings
COPY services/admin-api /services/admin-api
RUN uv sync --frozen --no-dev
RUN mkdir -p /work/agent-workspaces
# Claude Code runs as one unprivileged user per worker slot, claude1..claude8 (uids 1001-1008, group claude, gid 1001):
# a session's CLI cannot read another session's environment or files. knowledge-claude-cli drops to the slot's user and
# gives it the session's own HOME, /home/claude/sessions/<session id> (0700); /home/claude is the only writable mount
# of the claude-code-worker container and belongs to root (0711). The CLI comes bundled in the claude-agent-sdk wheel
# (no Node.js). Files under DATA_ROOT must be readable by the claude users (world-readable, or group-readable by gid 1001).
RUN groupadd --gid 1001 claude \
    && for slot in 1 2 3 4 5 6 7 8; do \
        useradd --uid "$((1000 + slot))" --gid claude --no-create-home --home-dir /home/claude --shell /usr/sbin/nologin "claude$slot"; \
    done \
    && install -d -o root -g root -m 711 /home/claude /home/claude/sessions \
    && install -d -o root -g root -m 700 /home/claude/tmp \
    && test "$(/services/admin-api/.venv/bin/python -c 'from knowledge_admin.claude_code_cli import MAX_SLOTS; print(MAX_SLOTS)')" = 8 \
    && test -x "$(/services/admin-api/.venv/bin/python -c 'import claude_agent_sdk, pathlib; print(pathlib.Path(claude_agent_sdk.__file__).parent / "_bundled" / "claude")')"
EXPOSE 8766
ENTRYPOINT ["uv", "run", "--frozen", "--no-dev", "knowledge-admin"]
CMD ["/work/data/docs", "--host", "0.0.0.0"]
