FROM node:22-bookworm-slim AS codegraph
WORKDIR /services/code-graph
COPY services/code-graph/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
RUN node node_modules/@ast-grep/cli/postinstall.js
COPY services/code-graph/index.cjs ./
COPY services/code-graph/query.cjs ./

# D2 draws System map diagrams; the release bundles the TALA, ELK and dagre layout engines.
FROM debian:bookworm-slim AS d2
ARG TARGETARCH
ARG D2_VERSION=v0.9.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
        amd64) sum=5669ddc46b99e942cc96078f4a4e36d5e62103348f4c05179ede27802fdd87a9 ;; \
        arm64) sum=ac2c028697199479acb321db1e3d68caee9f2ba492ed73caa3cd13f3829bf913 ;; \
        *) echo "d2: unsupported architecture $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/d2.tar.gz "https://github.com/d2lang/d2/releases/download/${D2_VERSION}/d2-${D2_VERSION}-linux-${arch}.tar.gz"; \
    echo "$sum  /tmp/d2.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/d2.tar.gz -C /tmp; \
    install -m 0755 "/tmp/d2-${D2_VERSION}/bin/d2" /usr/local/bin/d2

FROM python:3.12-slim
COPY --from=codegraph /usr/local/bin/node /usr/local/bin/node
COPY --from=codegraph /services/code-graph /services/code-graph
COPY --from=codegraph /services/code-graph/node_modules/@ast-grep/cli/ast-grep /usr/local/bin/ast-grep
RUN ast-grep --version
COPY --from=d2 /usr/local/bin/d2 /usr/local/bin/d2
RUN d2 --version
RUN apt-get update && apt-get install -y --no-install-recommends bash bubblewrap git openssh-client ripgrep ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
WORKDIR /services/admin-api
COPY packages/llm-settings /packages/llm-settings
COPY services/admin-api /services/admin-api
RUN uv sync --frozen --no-dev
RUN mkdir -p /work/agent-workspaces
EXPOSE 8766
ENTRYPOINT ["uv", "run", "--frozen", "--no-dev", "knowledge-admin"]
CMD ["/work/data/docs", "--host", "0.0.0.0"]
