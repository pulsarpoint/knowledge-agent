FROM python:3.12-slim
RUN pip install --no-cache-dir uv
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /services/code-agent
RUN ln -s /services/code-agent /app
COPY packages/llm-settings /packages/llm-settings
COPY services/code-agent/pyproject.toml services/code-agent/uv.lock ./
COPY services/code-agent/src ./src
RUN uv sync --frozen --no-dev
COPY deploy/code-agent/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 8795
ENTRYPOINT ["/entrypoint.sh"]
