# rag service environment configuration (copy to .env and edit; .env is gitignored).
#
# All values are OPTIONAL — used to configure embeddings for retrieval.
# Environment variables override the [llm] block in config.toml.

# OpenAI-compatible endpoint serving embeddings (Ollama, vLLM, LM Studio…).
RAG_EMBED_BASE_URL=http://localhost:11434/v1

# Model used for embeddings ("encoding") at index time.
RAG_EMBED_MODEL=nomic-embed-text

# API key, only if your endpoint requires one (local Ollama does not).
# Secrets belong here (in .env), never in config.toml.
RAG_API_KEY=
