# docs-wiki environment configuration (copy to .env and edit; .env is gitignored).
#
# Environment variables override the matching [llm]/[rag]/[server] key in
# config.toml. Only DOCS_WIKI_RAG_URL is required (by `serve`); everything
# else is optional.

# Where the rag service is reachable. Required — `serve` exits with an
# error if this and [rag] url are both unset. Reading, search, and Ask
# all depend on it; docs-wiki no longer indexes or embeds anything itself.
DOCS_WIKI_RAG_URL=http://localhost:8790

# OpenAI-compatible endpoint serving chat completions (Ollama, vLLM, LM Studio…).
# Used by Ask only — reading and search need none of this.
DOCS_WIKI_LLM_BASE_URL=http://localhost:11434/v1

# API key, only if your endpoint requires one (local Ollama does not).
# Secrets belong here (in .env), never in config.toml.
DOCS_WIKI_LLM_API_KEY=

# Model used to answer Ask questions.
DOCS_WIKI_CHAT_MODEL=qwen2.5:14b

# Optional: allowed CORS origin for a separately-served UI (dev).
DOCS_WIKI_CORS_ORIGIN=

# Optional: path to the built UI (build/client); auto-detected when absent.
DOCS_WIKI_UI_DIST=

# Optional: reasoning effort sent with chat requests (none/minimal/low/
# medium/high). Overrides the built-in per-model profiles; leave unset to
# send nothing for generic models (the luna profile sends "none").
DOCS_WIKI_REASONING_EFFORT=

# Optional: where gaps.jsonl and sessions.db are written, per app
# (<state_dir>/<app>/...). Defaults to ~/.local/state/docs-wiki.
DOCS_WIKI_STATE_DIR=

# Optional: enables "Ask the code" (escalating a NOT_COVERED chat turn to
# a separate, read-only code-question service). Leave unset to leave
# escalation off; nothing else changes.
DOCS_WIKI_CODE_AGENT_URL=

# Per-question tool budget override (positive int; unset = defaults
# 6 docs-only / 16 with code tools).
#DOCS_WIKI_MAX_TURNS=24
