# make setup generates the blank local secrets. Existing values are preserved.
POSTGRES_PASSWORD=
POSTGRES_PORT=5438
WEB_HOST=localhost
WEB_PORT=8180
ADMIN_PORT=8183
KEYCLOAK_PORT=8181
PHOENIX_PORT=8182
# Browser-accessible address used by the agent board's trace links.
PHOENIX_PUBLIC_URL=http://localhost:8182
# Optional host/VPN search domain for the admin container, e.g. tailXXXX.ts.net.
DOCKER_DNS_SEARCH=

# Absolute host folder for the application's files; set it with
#   make setup DATA_ROOT=/opt/knowledge-agent
# The database, Keycloak and Phoenix keep their data in Docker volumes.
DATA_ROOT=
# Folders inside DATA_ROOT, as relative paths: no leading /, no .., no hidden
# segments, and none inside another. RAG reads all of DATA_ROOT; each service
# writes only its own folder. Keep anything else (backups, logs) outside DATA_ROOT.
CODE_FOLDER=code
CODE_INDEX_FOLDER=code-index
DOCS_FOLDER=docs
GENERATED_DOCS_FOLDER=generated-documents
JIRA_FOLDER=jira
# Back up this key with the database; replacing it makes saved GitHub tokens unreadable.
CREDENTIAL_ENCRYPTION_KEY=
# Internal authentication between backoffice and the folder RAG API.
RAG_BACKOFFICE_KEY=
# Internal key for Reader chat calls from docs-wiki to admin-api (generated by make setup)
READER_AGENT_KEY=

KEYCLOAK_ADMIN_PASSWORD=
APP_ADMIN_USERNAME=v3-admin
APP_ADMIN_EMAIL=v3-admin@example.test
APP_ADMIN_PASSWORD=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
ADMIN_OAUTH2_PROXY_CLIENT_SECRET=
ADMIN_OAUTH2_PROXY_COOKIE_SECRET=
PHOENIX_SECRET=
PHOENIX_ADMIN_PASSWORD=
PHOENIX_ADMIN_SECRET=
LITELLM_MASTER_KEY=

# Optional LiteLLM gateway. Configure its URL and model in RAG Settings.
AWS_REGION=eu-central-1
AWS_BEARER_TOKEN_BEDROCK=

# Configure agent models and provider credentials in Admin > LLM Settings.
# AWS variables above are only for the optional legacy LiteLLM / embedding gateway.

